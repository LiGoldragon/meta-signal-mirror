;; Every owner Mirror request root, in encoded canonical order.
RetireStore.mirror-aab
RegisterStore.{ mirror-aab Opaque }
Configure.{ fixture { socket-aab 7 } { socket-aab 7 } { host-aab 7474 } }
ObserveRegistry.{}
SetRetention.{ AllStores KeepLatestCheckpoints.7 }

;; Every owner Mirror reply root, in encoded canonical order.
StoreRegistered.mirror-aab
RegistryObserved.{ [ mirror-aab ] }
RetentionSet.{ AllStores KeepLatestCheckpoints.7 }
OrderRejected.{ StoreUnknown fixture }
StoreRetired.mirror-aab
Configured.{ fixture { socket-aab 7 } { socket-aab 7 } { host-aab 7474 } }
